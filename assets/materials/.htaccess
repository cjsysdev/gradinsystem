# Uploaded course materials. Static downloads only — never executable.
# See Class_material::ensure_base_dir() for why each line is here.
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php5.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>

RemoveHandler .php .phtml .php3 .php4 .php5 .php6 .php7 .php8 .phps .pht .phar .cgi .pl .py .sh .asp .aspx .jsp
RemoveType .php .phtml .php3 .php4 .php5 .php6 .php7 .php8 .phps .pht .phar
AddType text/plain .php .phtml .php3 .php4 .php5 .php6 .php7 .php8 .phps .pht .phar .cgi .pl .py .sh

Options -ExecCGI -Indexes

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
</IfModule>

<FilesMatch "\.(?i:php[0-9]?|phtml|phps|pht|phar|cgi|pl|sh|hta|htaccess)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
