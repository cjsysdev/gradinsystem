            "id": 1,
            "title": "Writing the INSERT",
            "callback": true,
            "refSection": 0,
            "chunks": [
                {
                    "text": "An INSERT names the <span class=\"highlight\">table</span>, then the columns, then the values: <span class=\"code-inline\">INSERT INTO students (name, age) VALUES (?, ?)</span>",
                    "check": {
                        "question": "What comes right after INSERT INTO?",
                        "options": [
                            "The table name",
                            "The column values"
                        ],
                        "correct": 0
                    }
                },
                {
                    "text": "Each <span class=\"code-inline\">?</span> is a placeholder that stands in for one <span class=\"highlight\">value</span> you will supply.",
                    "check": {
                        "question": "What does a ? stand for?",
                        "options": [
                            "One value",
                            "One table"
                        ],
                        "correct": 0
                    }
                },
                {
                    "text": "The number of question marks must <span class=\"highlight\">match</span> the number of columns you listed.",
                    "check": {
                        "question": "Three columns need how many ?",
                        "options": [
                            "Three",
                            "One"
                        ],
                        "correct": 0
                    }
                }
            ],
            "quiz": {
                "type": "arrange",
                "question": "Arrange the parts of an INSERT statement in the correct order.",
                "tokens": [
                    "VALUES (?, ?)",
                    "INSERT INTO",
                    "(name, age)",
                    "students"
                ],
                "correctOrder": [
                    "INSERT INTO",
                    "students",
                    "(name, age)",
                    "VALUES (?, ?)"
                ]
            }
        },
        {
